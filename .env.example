# Copia este archivo a .env y rellena las claves de tu entorno.
# .env está ignorado por Git: las claves nunca van al código, a Teams ni a un commit.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Despliegues reales (listados el 26/11): gpt-6.1-sol, gpt-6-luna. No hay gpt-6.2.
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=claude-sonnet-5-5
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
TRAZIA_EXTERNAL_PROVIDERS=synthetic_only
# Enrutador de modelos (docs/PLAN.md 7.8). Despliegue o modelo por nivel; vacío = valor por defecto.
TRAZIA_AZURE_OPENAI_NIVEL1=gpt-6-luna
TRAZIA_AZURE_OPENAI_NIVEL2=gpt-6.1-sol
TRAZIA_AZURE_OPENAI_NIVEL3=gpt-6.1-sol
TRAZIA_AZURE_CLAUDE_NIVEL1=claude-sonnet-5-5
TRAZIA_AZURE_CLAUDE_NIVEL2=claude-sonnet-5-5
TRAZIA_AZURE_CLAUDE_NIVEL3=claude-sonnet-5-5
# Sonnet va primero en niveles 2 y 3. Para datos del reto, activa Foundry una vez autorizado.
TRAZIA_SONNET_DATOS_RETO=0
# Tokens por proceso antes de dejar de usar el nivel 3 (vacío o 0: sin tope) y llamadas de nivel 3
# por revisión.
TRAZIA_PRESUPUESTO_TOKENS=
TRAZIA_NIVEL3_MAX=5
# Precios: € por millón de tokens "entrada,salida" por modelo, y cambio para los de lista en USD.
TRAZIA_PRECIO_GPT_6_LUNA=
TRAZIA_PRECIO_GPT_6_1_SOL=
TRAZIA_EUR_POR_USD=
